name = "multiversaltherapy-linkbio"
main = "worker.js"
compatibility_date = "2026-08-26"

[vars]
ALLOWED_ORIGIN = "https://multiversaltherapy.github.io"

[[analytics_engine_datasets]]
binding = "ANALYTICS"
dataset = "multiversaltherapy_linkbio"

